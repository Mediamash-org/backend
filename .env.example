# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
PUBLIC_URL=http://localhost:3000

# Required — https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_CACHE_TTL=86400
# Optional image CDN base used by /api/* metadata responses
# TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# Cache: memory | redis
CACHE_TYPE=memory
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# When true, skip live URL reachability checks (useful with the example provider)
INTERNAL_DEBUG=true

# Provider plugins (optional — prefer config/providers.json)
# OMSS_PROVIDERS_CONFIG=config/providers.json
# OMSS_PROVIDER_PLUGINS=@omss-server/netmirror-provider
# OMSS_PROVIDERS_DISABLED=

# NetMirror provider (optional overrides)
# NETMIRROR_BASE_URL=https://net27.cc
# NETMIRROR_STREAM_REFERER=https://videodownloader.site/
# NETMIRROR_FETCH_DUBS=true
# NETMIRROR_TIMEOUT_MS=15000

# Peachify provider (optional overrides)
# PEACHIFY_BASE_URL=https://peachify.top
# PEACHIFY_API_URL=https://usa.eat-peach.sbs
# PEACHIFY_MOVIEBOX_URL=https://uwu.eat-peach.sbs
# PEACHIFY_SERVERS=holly,air,multi,moviebox,net
# PEACHIFY_AES_KEY_HEX=
# PEACHIFY_TIMEOUT_MS=20000

# VidSrc provider (optional overrides) — https://vsembed.ru/
# VIDSRC_BASE_URL=https://vsembed.ru
# VIDSRC_STREAM_REFERER=https://cloudnestra.com/
# VIDSRC_TIMEOUT_MS=20000

# 2Embed provider (optional overrides) — https://www.2embed.online/
# TWOEMBED_BASE_URL=https://www.2embed.online
# TWOEMBED_STREAM_HOST=https://play.xpass.top
# TWOEMBED_TIMEOUT_MS=20000

# Bingr provider (optional overrides) — https://bingr.one/
# BINGR_SITE_URL=https://bingr.one
# BINGR_API_URL=https://api.bingr.one/api
# BINGR_SERVERS=s11,s30,s3,s4
# BINGR_TIMEOUT_MS=20000
# BINGR_FETCH_VDRK_SUBS=true

# StreamingUnity provider (optional overrides) — https://streamingunity.vip/
# STREAMINGUNITY_BASE_URL=https://streamingunity.vip
# STREAMINGUNITY_LOCALE=en
# STREAMINGUNITY_TIMEOUT_MS=20000
# STREAMINGUNITY_MAX_SEARCH=8

# Filmo provider (optional overrides) — https://filmo.to/ (movies only, via VOE)
# FILMO_BASE_URL=https://filmo.to
# FILMO_TIMEOUT_MS=20000
# FILMO_MAX_PROVIDERS=4

# Pikashow provider (CNCVerse CloudStream port) — https://manoda.co/
# PIKASHOW_BASE_URL=https://manoda.co
# PIKASHOW_API_KEY=picashow-api-secret-key
# PIKASHOW_HMAC_SECRET=picashow-api-secret-2025
# PIKASHOW_TIMEOUT_MS=25000
# PIKASHOW_PREFERRED_LANGS=English,Hindi
# PIKASHOW_MAX_LANGS=4

