# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
PUBLIC_URL=http://localhost:3000

# Required — https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_CACHE_TTL=86400

# Cache: memory | redis
CACHE_TYPE=memory
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# When true, skip live URL reachability checks (useful with the example provider)
INTERNAL_DEBUG=true

# Provider plugins (optional — prefer config/providers.json)
# OMSS_PROVIDERS_CONFIG=config/providers.json
# OMSS_PROVIDER_PLUGINS=@omss-server/netmirror-provider
# OMSS_PROVIDERS_DISABLED=

# NetMirror provider (optional overrides)
# NETMIRROR_BASE_URL=https://net27.cc
# NETMIRROR_STREAM_REFERER=https://videodownloader.site/
# NETMIRROR_FETCH_DUBS=true
# NETMIRROR_TIMEOUT_MS=15000

