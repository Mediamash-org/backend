# Copy to `.env` before `docker compose up`:
#   cp .env.docker.example .env
#
# Required secrets — never commit the real `.env`.

# ── Public identity ─────────────────────────────────────────────────────────
# Must be the URL clients (webOS / browsers / reverse proxy) use to reach this
# host. Proxy stream URLs are minted from PUBLIC_URL.
PUBLIC_URL=https://omss.example.com
OMSS_NAME=MediaMash
OMSS_VERSION=1.1.0

# Host port published by Compose (container always listens on 3000)
OMSS_HOST_PORT=3000

# ── TMDB (required) ─────────────────────────────────────────────────────────
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=replace_with_your_tmdb_v3_key
TMDB_CACHE_TTL=86400
# TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# ── Cache (Compose sets CACHE_TYPE=redis + REDIS_HOST=redis) ────────────────
# Leave these as-is when using the bundled Redis service.
CACHE_TYPE=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Source probing ──────────────────────────────────────────────────────────
# Keep INTERNAL_DEBUG=false in production so dead streams are filtered.
INTERNAL_DEBUG=false
SOURCE_PROBE_TIMEOUT_MS=12000
SOURCE_PROBE_CACHE_TTL_MS=180000

# ── Framework cache TTLs (seconds) ──────────────────────────────────────────
CACHE_SOURCES_TTL=7200
CACHE_SUBTITLES_TTL=86400

# ── Optional provider overrides ─────────────────────────────────────────────
# OMSS_PROVIDERS_CONFIG=config/providers.json
# OMSS_PROVIDERS_DISABLED=
# NETMIRROR_BASE_URL=https://net27.cc
# BINGR_SITE_URL=https://bingr.one
# VIDCORE_TIMEOUT_MS=20000
